{
  "name": "modsmith",
  "productName": "Modsmith",
  "version": "0.1.19",
  "description": "Desktop workbench for Minecraft mod and modpack development",
  "private": true,
  "bin": {
    "modsmith": "bin/modsmith.cjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:renderer": "vite build",
    "build:bridge": "node scripts/build-bridge.mjs",
    "site:build": "node site/build.mjs",
    "site:serve": "node site/build.mjs && node site/serve.mjs",
    "dev:renderer": "vite",
    "start": "npm run tauri:dev",
    "dev": "npm run tauri:dev",
    "tauri": "tauri",
    "tauri:prepare": "node scripts/build.mjs && node scripts/build-service.mjs && node scripts/linux-metadata.mjs",
    "build:service": "node scripts/build-service.mjs",
    "tauri:dev": "npm run tauri:prepare && tauri dev",
    "tauri:build": "npm run tauri:prepare && tauri build",
    "setup:build": "npm run tauri:prepare && tauri build --no-bundle && node scripts/build-setup.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "test:node": "node scripts/test.mjs --node-only",
    "test:rust": "node scripts/test.mjs --rust-only",
    "smoke": "node scripts/smoke.mjs",
    "smoke:neoforge": "node scripts/smoke.mjs --entry neoforge-1.21.1",
    "mcp-config": "node bin/modsmith.cjs mcp config"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/lsp-client": "^6.3.0",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/server": "^2.3.1",
    "codemirror": "^6.0.2",
    "dockview-react": "^8.6.1",
    "fflate": "^0.8.3",
    "json5": "^2.2.3",
    "koffi": "^3.3.3",
    "lucide-react": "^1.59.0",
    "material-icon-theme": "^5.39.0",
    "react": "19.2",
    "react-dom": "19.2",
    "react-resizable-panels": "^4.14.6",
    "smol-toml": "^1.9.1",
    "ssh2": "^1.17.0",
    "vscode-json-languageservice": "5.7.2",
    "vscode-languageserver-textdocument": "1.0.12",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
