{
  "bundle": {
    "targets": ["deb", "appimage"],
    "linux": {
      "deb": {
        "depends": ["libdbus-1-3"],
        "section": "devel",
        "priority": "optional",
        "desktopTemplate": "linux/modsmith.desktop",
        "files": {
          "/usr/share/metainfo/dev.modsmith.workbench.metainfo.xml": "linux/generated/dev.modsmith.workbench.metainfo.xml",
          "/usr/share/icons/hicolor/scalable/apps/modsmith.svg": "../resources/brand/modsmith.svg",
          "/usr/share/doc/modsmith/copyright": "linux/generated/copyright"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/metainfo/dev.modsmith.workbench.metainfo.xml": "linux/generated/dev.modsmith.workbench.metainfo.xml",
          "/usr/share/icons/hicolor/scalable/apps/modsmith.svg": "../resources/brand/modsmith.svg"
        }
      }
    }
  }
}
