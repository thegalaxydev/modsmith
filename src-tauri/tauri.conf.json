{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modsmith",
  "version": "0.1.16",
  "identifier": "dev.modsmith.workbench",
  "build": {
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Galaxy Development LLC",
    "homepage": "https://thegalaxydev.github.io/modsmith/",
    "category": "DeveloperTool",
    "icon": ["icons/512x512.png", "icons/256x256.png", "icons/128x128.png", "icons/64x64.png", "icons/48x48.png", "icons/32x32.png", "../resources/brand/modsmith.ico"],
    "externalBin": ["binaries/modsmith-service"],
    "resources": {
      "../resources/catalog/": "resources/catalog/",
      "../resources/templates/": "resources/templates/",
      "../resources/gradle/": "resources/gradle/",
      "../resources/bridge/": "resources/bridge/"
    },
    "shortDescription": "Minecraft Development Studio for Fabric, NeoForge and Forge mods",
    "longDescription": "Modsmith creates Fabric, NeoForge and Forge mod projects from the official templates, edits Java and JSON with completion, builds with Gradle, and runs a test client or dedicated server inside its own window.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
